<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Guia HTML & CSS</title>

<style>

/* ===== RESET ===== */
body {
    margin: 0;
    font-family: Arial, sans-serif;
}

/* ===== LAYOUT ===== */
.layout {
    display: flex;
}

/* ===== MENU LATERAL ===== */
.sidebar {
    width: 250px;
    background: #111827;
    color: white;
    height: 100vh;
    padding: 20px;
    position: fixed;
}

.sidebar h2 {
    margin-top: 0;
}

/* Links do menu */
.sidebar a {
    display: block;
    color: #ccc;
    text-decoration: none;
    margin: 8px 0;
}

.sidebar a:hover {
    color: #38bdf8;
}

/* ===== CONTEÚDO ===== */
.content {
    margin-left: 270px;
    padding: 30px;
}

/* Seções */
.section {
    margin-bottom: 40px;
}

/* Caixa de exemplo */
.example {
    background: #f4f4f4;
    padding: 15px;
    border-left: 5px solid #38bdf8;
    margin-top: 10px;
}

/* Código */
.code {
    background: #111;
    color: #0f0;
    padding: 10px;
    font-family: monospace;
}

/* Resultado */
.result {
    background: white;
    padding: 10px;
    border: 1px solid #ccc;
    margin-top: 10px;
}

</style>
</head>

<body>

<div class="layout">

<!-- ===== MENU ===== -->
<div class="sidebar">
    <h2>Guia</h2>

    <h3>HTML</h3>
    <a href="#h1">Heading</a>
    <a href="#p">Parágrafo</a>
    <a href="#a">Link</a>
    <a href="#img">Imagem</a>
    <a href="#ul">Lista</a>

    <h3>CSS</h3>
    <a href="#color">Color</a>
    <a href="#margin">Margin</a>
    <a href="#padding">Padding</a>
    <a href="#flex">Flexbox</a>
</div>

<!-- ===== CONTEÚDO ===== -->
<div class="content">

<h1>Guia HTML & CSS</h1>
<p>Exemplos práticos de uso.</p>

<!-- ===== HTML ===== -->

<div id="h1" class="section">
<h2>&lt;h1&gt; - Títulos</h2>
<p>Define títulos.</p>

<div class="example">
<div class="code">
&lt;h1&gt;Título&lt;/h1&gt;
</div>

<div class="result">
<h1>Exemplo de Título</h1>
</div>
</div>
</div>

<div id="p" class="section">
<h2>&lt;p&gt; - Parágrafo</h2>

<div class="example">
<div class="code">
&lt;p&gt;Texto aqui&lt;/p&gt;
</div>

<div class="result">
<p>Texto aqui</p>
</div>
</div>
</div>

<div id="a" class="section">
<h2>&lt;a&gt; - Link</h2>

<div class="example">
<div class="code">
&lt;a href="#"&gt;Clique&lt;/a&gt;
</div>

<div class="result">
<a href="#">Clique aqui</a>
</div>
</div>
</div>

<div id="img" class="section">
<h2>&lt;img&gt; - Imagem</h2>

<div class="example">
<div class="code">
&lt;img src="img.png"&gt;
</div>

<div class="result">
<img src="https://via.placeholder.com/100">
</div>
</div>
</div>

<div id="ul" class="section">
<h2>&lt;ul&gt; - Lista</h2>

<div class="example">
<div class="code">
&lt;ul&gt;
&lt;li&gt;Item&lt;/li&gt;
&lt;/ul&gt;
</div>

<div class="result">
<ul>
<li>Item 1</li>
<li>Item 2</li>
</ul>
</div>
</div>
</div>

<!-- ===== CSS ===== -->

<div id="color" class="section">
<h2>color</h2>

<div class="example">
<div class="code">
p { color: red; }
</div>

<div class="result">
<p style="color:red;">Texto vermelho</p>
</div>
</div>
</div>

<div id="margin" class="section">
<h2>margin</h2>

<div class="example">
<div class="code">
div { margin: 20px; }
</div>

<div class="result">
<div style="margin:20px; background:#ddd;">Exemplo</div>
</div>
</div>
</div>

<div id="padding" class="section">
<h2>padding</h2>

<div class="example">
<div class="code">
div { padding: 20px; }
</div>

<div class="result">
<div style="padding:20px; background:#ddd;">Exemplo</div>
</div>
</div>
</div>

<div id="flex" class="section">
<h2>Flexbox</h2>

<div class="example">
<div class="code">
display: flex;
</div>

<div class="result" style="display:flex; gap:10px;">
<div style="background:#ddd; padding:10px;">1</div>
<div style="background:#ddd; padding:10px;">2</div>
</div>
</div>
</div>

</div>
</div>

</body>
</html>
